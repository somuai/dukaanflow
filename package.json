{
  "name": "dukaanflow",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./modules"
    }
  },
  "scripts": {
    "start": "expo start",
    "ios": "./scripts/build-ios.sh",
    "ios:device": "./scripts/build-ios-device.sh",
    "ios:dev-server": "expo start --dev-client",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-loader ./test/support/expo-native-loader.mjs --test test/*.test.ts"
  },
  "dependencies": {
    "@expo/metro-runtime": "~55.0.12",
    "expo": "~55.0.32",
    "expo-asset": "~55.0.20",
    "expo-blur": "~55.0.18",
    "expo-build-properties": "~55.0.18",
    "expo-camera": "~55.0.23",
    "expo-constants": "~55.0.17",
    "expo-crypto": "~55.0.19",
    "expo-dev-client": "~55.0.41",
    "expo-device": "~55.0.21",
    "expo-file-system": "~55.0.26",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.18",
    "expo-image-picker": "~55.0.24",
    "expo-keep-awake": "~55.0.8",
    "expo-linking": "~55.0.17",
    "expo-router": "~55.0.18",
    "expo-speech": "~55.0.18",
    "expo-splash-screen": "~55.0.25",
    "expo-sqlite": "~55.0.20",
    "expo-status-bar": "~55.0.6",
    "expo-symbols": "~55.0.9",
    "invoice-ocr": "file:modules/invoice-ocr",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-nitro-modules": "^0.36.5",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.7.4"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~55.0.25",
    "typescript": "~5.9.2"
  },
  "packageManager": "npm@10.9.3"
}
